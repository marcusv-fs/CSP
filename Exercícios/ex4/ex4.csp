-- Limites
MAX_INSUMO = 8
MAX_CREDITO = 8
LIM_VALORES = {1..8}

-- Usuários
N_USUARIOS = 2
ID = {1..N_USUARIOS}

-- Preços
pCafe = 2
pCafeLeite = 3
pChoco = 4
pCappuc = 5

-- Tipos de dados
datatype Bebidas = cafe | cafe_c_leite | chocolate | cappuccino
datatype Insumos = insumo_cafe | insumo_leite | insumo_choco

-- Canais
channel escolher : ID.Bebidas
channel ins_creditos : ID.LIM_VALORES 
channel descontar : ID.LIM_VALORES 
channel servir : ID.Bebidas
channel aviso_falta : Insumos
channel repor : Insumos.LIM_VALORES

Pagamento_ND = 
    ins_creditos?id?val:{pCafe, pCafeLeite, pChoco, pCappuc} -> PagamentoUsuario_ND(id, val)

PagamentoUsuario_ND(id, cdt) = 
    cdt == pCafe & escolher.id!cafe -> descontar.id!pCafe -> servir.id!cafe -> Pagamento_ND
    []
    cdt == pCafeLeite & escolher.id!cafe_c_leite -> descontar.id!pCafeLeite -> servir.id!cafe_c_leite -> Pagamento_ND
    []
    cdt == pChoco & escolher.id!chocolate -> descontar.id!pChoco -> servir.id!chocolate -> Pagamento_ND
    []
    cdt == pCappuc & escolher.id!cappuccino -> descontar.id!pCappuc -> servir.id!cappuccino -> Pagamento_ND

Dispensador_ND =
    (escolher?id!cafe -> descontar.id!pCafe -> servir!id!cafe -> Dispensador_ND)
    []
    (escolher?id!cafe_c_leite -> descontar.id!pCafeLeite -> servir!id!cafe_c_leite -> Dispensador_ND)
    []
    (escolher?id!chocolate -> descontar.id!pChoco -> servir!id!chocolate -> Dispensador_ND)
    []
    (escolher?id!cappuccino -> descontar.id!pCappuc -> servir!id!cappuccino -> Dispensador_ND)
    |~|
    (escolher?id?bebida -> descontar.id!pCappuc -> servir!id?bebida -> Dispensador_ND)

Aviso_ND(c, l, ch) =
    (c == 0 & aviso_falta!insumo_cafe -> Aviso_ND(c - 1, l, ch))
    []
    (l == 0 & aviso_falta!insumo_leite -> Aviso_ND(c, l - 1, ch))
    []
    (ch == 0 & aviso_falta!insumo_choco -> Aviso_ND(c, l, ch - 1))
    []
    (c != 0 and l != 0 and ch != 0 & GerenciadorEstoque_ND(c, l, ch))
    

Reposicao_ND(c, l, ch) =
    repor!insumo_cafe?qtd:{1 .. (if c == -1 then MAX_INSUMO else MAX_INSUMO - c) } -> 
        GerenciadorEstoque_ND(if c == -1 then c + qtd + 1 else c + qtd, l, ch)
    []
    repor!insumo_leite?qtd:{1 .. (if l == -1 then MAX_INSUMO else MAX_INSUMO - l) } -> 
        GerenciadorEstoque_ND(c, if l == -1 then l + qtd + 1 else l + qtd, ch)
    []
    repor!insumo_choco?qtd:{1 .. (if ch == -1 then MAX_INSUMO else MAX_INSUMO - ch) } -> 
        GerenciadorEstoque_ND(c, l, if ch == -1 then ch + qtd + 1 else ch + qtd)

Consumo_ND(c, l, ch) =
    (c >= 3 & escolher?id!cafe -> servir!id!cafe -> Aviso_ND(c-3, l, ch))
    []
    (c >= 1 and l >= 2 & escolher?id!cafe_c_leite -> servir!id!cafe_c_leite -> Aviso_ND(c-1, l-2, ch))
    []
    (ch >= 3 & escolher?id!chocolate -> servir!id!chocolate -> Aviso_ND(c, l, ch-3))
    []
    (c >= 1 and l >= 1 and ch >= 1 & escolher?id!cappuccino -> servir!id!cappuccino -> Aviso_ND(c-1, l-1, ch-1))
    |~|
    (escolher?id?bebida -> servir!id!cafe -> Aviso_ND(c, l, ch))

GerenciadorEstoque_ND(c, l, ch) =
    Consumo_ND(c, l, ch)
    []
    Reposicao_ND(c, l, ch)

PAG_DISP_ND = Pagamento_ND [| {| escolher, descontar, servir |} |] Dispensador_ND

MAQUINA_BASE_ND = PAG_DISP_ND [| {| escolher, servir |} |] GerenciadorEstoque_ND(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO)

-- Máquina com ocultação
MAQUINA_ND = MAQUINA_BASE_ND \ {| descontar |}

Usuario_ND(id) =
    ins_creditos.id!pCafe -> escolher.id!cafe -> servir.id!cafe -> Usuario_ND(id)
    []
    ins_creditos.id!pCafeLeite -> escolher.id!cafe_c_leite -> servir.id!cafe_c_leite -> Usuario_ND(id)
    []
    ins_creditos.id!pChoco -> escolher.id!chocolate -> servir.id!chocolate -> Usuario_ND(id)
    []
    ins_creditos.id!pCappuc -> escolher.id!cappuccino -> servir.id!cappuccino -> Usuario_ND(id)

-- Criar os N usuários em paralelo, o @ funciona como um "para cada" i
USUARIOS_ND = ||| i : ID @ Usuario_ND(i)

SISTEMA_ND = MAQUINA_ND [| {| ins_creditos, escolher, servir |} |] USUARIOS_ND

SO_REPOSICAO_ND = 
    repor?i?q -> SO_REPOSICAO_ND
    []
    aviso_falta?i -> SO_REPOSICAO_ND
    []
    ins_creditos?id?val -> SO_REPOSICAO_ND

-- Verificações
assert SISTEMA_ND :[deterministic]
assert SISTEMA_ND :[deadlock free]
assert SISTEMA_ND :[divergence free]

assert SO_REPOSICAO_ND [T= SISTEMA_ND \ {| escolher, descontar, servir |}

-- Máquina sem os problemas

Pagamento = 
    ins_creditos?id?val:{pCafe, pCafeLeite, pChoco, pCappuc} -> PagamentoUsuario(id, val)

PagamentoUsuario(id, cdt) = 
    cdt == pCafe & escolher.id!cafe -> descontar.id!pCafe -> servir.id!cafe -> Pagamento
    []
    cdt == pCafeLeite & escolher.id!cafe_c_leite -> descontar.id!pCafeLeite -> servir.id!cafe_c_leite -> Pagamento
    []
    cdt == pChoco & escolher.id!chocolate -> descontar.id!pChoco -> servir.id!chocolate -> Pagamento
    []
    cdt == pCappuc & escolher.id!cappuccino -> descontar.id!pCappuc -> servir.id!cappuccino -> Pagamento

Dispensador =
    (escolher?id!cafe -> descontar.id!pCafe -> servir!id!cafe -> Dispensador)
    []
    (escolher?id!cafe_c_leite -> descontar.id!pCafeLeite -> servir!id!cafe_c_leite -> Dispensador)
    []
    (escolher?id!chocolate -> descontar.id!pChoco -> servir!id!chocolate -> Dispensador)
    []
    (escolher?id!cappuccino -> descontar.id!pCappuc -> servir!id!cappuccino -> Dispensador)

Aviso(c, l, ch) =
    (c == 0 & aviso_falta!insumo_cafe -> Aviso(c - 1, l, ch))
    []
    (l == 0 & aviso_falta!insumo_leite -> Aviso(c, l - 1, ch))
    []
    (ch == 0 & aviso_falta!insumo_choco -> Aviso(c, l, ch - 1))
    []
    (c != 0 and l != 0 and ch != 0 & GerenciadorEstoque(c, l, ch))
    

Reposicao(c, l, ch) =
    repor!insumo_cafe?qtd:{1 .. (if c == -1 then MAX_INSUMO else MAX_INSUMO - c) } -> 
        GerenciadorEstoque(if c == -1 then c + qtd + 1 else c + qtd, l, ch)
    []
    repor!insumo_leite?qtd:{1 .. (if l == -1 then MAX_INSUMO else MAX_INSUMO - l) } -> 
        GerenciadorEstoque(c, if l == -1 then l + qtd + 1 else l + qtd, ch)
    []
    repor!insumo_choco?qtd:{1 .. (if ch == -1 then MAX_INSUMO else MAX_INSUMO - ch) } -> 
        GerenciadorEstoque(c, l, if ch == -1 then ch + qtd + 1 else ch + qtd)

Consumo(c, l, ch) =
    (c >= 3 & escolher?id!cafe -> servir!id!cafe -> Aviso(c-3, l, ch))
    []
    (c >= 1 and l >= 2 & escolher?id!cafe_c_leite -> servir!id!cafe_c_leite -> Aviso(c-1, l-2, ch))
    []
    (ch >= 3 & escolher?id!chocolate -> servir!id!chocolate -> Aviso(c, l, ch-3))
    []
    (c >= 1 and l >= 1 and ch >= 1 & escolher?id!cappuccino -> servir!id!cappuccino -> Aviso(c-1, l-1, ch-1))

GerenciadorEstoque(c, l, ch) =
    Consumo(c, l, ch)
    []
    Reposicao(c, l, ch)

PAG_DISP = Pagamento [| {| escolher, descontar, servir |} |] Dispensador

MAQUINA_BASE = PAG_DISP [| {| escolher, servir |} |] GerenciadorEstoque(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO)

-- Máquina com ocultação
MAQUINA = MAQUINA_BASE \ {| descontar |}

SO_REPOSICAO = 
    repor?i?q -> SO_REPOSICAO
    []
    aviso_falta?i -> SO_REPOSICAO
    []
    ins_creditos?id?val -> SO_REPOSICAO

Usuario(id) =
    ins_creditos.id!pCafe -> escolher.id!cafe -> servir.id!cafe -> Usuario(id)
    []
    ins_creditos.id!pCafeLeite -> escolher.id!cafe_c_leite -> servir.id!cafe_c_leite -> Usuario(id)
    []
    ins_creditos.id!pChoco -> escolher.id!chocolate -> servir.id!chocolate -> Usuario(id)
    []
    ins_creditos.id!pCappuc -> escolher.id!cappuccino -> servir.id!cappuccino -> Usuario(id)

USUARIOS = ||| i : ID @ Usuario(i)

SISTEMA = MAQUINA [| {| ins_creditos, escolher, servir |} |] USUARIOS

-- Verificações
assert SISTEMA :[deterministic]
assert SISTEMA :[deadlock free]
assert SISTEMA :[divergence free]

assert SO_REPOSICAO [T= SISTEMA \ {| escolher, descontar, servir |}


assert SISTEMA_ND [F= SISTEMA
assert SISTEMA [F= SISTEMA_ND

assert Dispensador_ND [F= Dispensador
assert Dispensador [F= Dispensador_ND

assert GerenciadorEstoque_ND(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO) [F= GerenciadorEstoque(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO)
assert GerenciadorEstoque(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO) [F= GerenciadorEstoque_ND(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO)

assert Consumo_ND(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO) [F= Consumo(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO)
assert Consumo(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO) [F= Consumo_ND(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO)

-- As seções da máquina que são identicas naturalmente se refinam.

-- Já nas seções com modificações, temos que as que apresentam problemas (não-determinismo e deadlock) refinam as que não apresentam, mas não o contrário, já que a máquina sem problemas é mais restritiva. Ou seja, a máquina sem problemas é um subconjunto da máquina com problemas, mas a máquina com problemas não é um subconjunto da máquina sem problemas. Por isso os refinamentos são unidirecionais.

-- Essa construção de que a máquina com problemas refina a sem problemas nem sempre é verdade em CSP, mas no caso desta implementação, como o que foi feito foi adicionar comportamentos (e não remover), isso é verdade. Se tivéssemos removido comportamentos, a máquina sem problemas poderia refinar a máquina com problemas, mas não o contrário.
