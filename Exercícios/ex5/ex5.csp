-- Limites
MAX_INSUMO = 8
MAX_CREDITO = 8
LIM_VALORES = {1..8}

-- Usuários
N_USUARIOS = 2
ID = {1..N_USUARIOS}

-- Preços
pCafe = 2
pCafeLeite = 3
pChoco = 4
pCappuc = 5

-- Tipos de dados
datatype Bebidas = cafe | cafe_c_leite | chocolate | cappuccino
datatype Insumos = insumo_cafe | insumo_leite | insumo_choco

BebidasQuentes = {cafe, cafe_c_leite, cappuccino}
BebidasFrias = {chocolate}

-- Canais
channel escolher : ID.Bebidas
channel ins_creditos : ID.LIM_VALORES 
channel descontar : ID.LIM_VALORES 
channel servir, servir_quente, servir_frio : ID.Bebidas
channel aviso_falta : Insumos
channel repor : Insumos.LIM_VALORES
channel preparar: Bebidas
channel autorizar, liberado : ID.Bebidas

Pagamento = 
    ins_creditos?id?val:{pCafe, pCafeLeite, pChoco, pCappuc} -> PagamentoUsuario(id, val)

PagamentoUsuario(id, cdt) = 
    (cdt == pCafe & escolher.id!cafe -> descontar.id!pCafe -> autorizar.id!cafe -> Pagamento)
    []
    (cdt == pCafeLeite & escolher.id!cafe_c_leite -> descontar.id!pCafeLeite -> autorizar.id!cafe_c_leite -> Pagamento)
    []
    (cdt == pChoco & escolher.id!chocolate -> descontar.id!pChoco -> autorizar.id!chocolate -> Pagamento)
    []
    (cdt == pCappuc & escolher.id!cappuccino -> descontar.id!pCappuc -> autorizar.id!cappuccino -> Pagamento)

Dispensador(Produtos) =
    liberado?id?bebida:Produtos -> preparar!bebida -> servir!id!bebida -> Dispensador(Produtos)

Aviso(c, l, ch) =
    (c == 0 & aviso_falta!insumo_cafe -> Aviso(c - 1, l, ch))
    []
    (l == 0 & aviso_falta!insumo_leite -> Aviso(c, l - 1, ch))
    []
    (ch == 0 & aviso_falta!insumo_choco -> Aviso(c, l, ch - 1))
    []
    (c != 0 and l != 0 and ch != 0 & GerenciadorEstoque(c, l, ch))
    

Reposicao(c, l, ch) =
    repor!insumo_cafe?qtd:{1 .. (if c == -1 then MAX_INSUMO else MAX_INSUMO - c) } -> 
        GerenciadorEstoque(if c == -1 then c + qtd + 1 else c + qtd, l, ch)
    []
    repor!insumo_leite?qtd:{1 .. (if l == -1 then MAX_INSUMO else MAX_INSUMO - l) } -> 
        GerenciadorEstoque(c, if l == -1 then l + qtd + 1 else l + qtd, ch)
    []
    repor!insumo_choco?qtd:{1 .. (if ch == -1 then MAX_INSUMO else MAX_INSUMO - ch) } -> 
        GerenciadorEstoque(c, l, if ch == -1 then ch + qtd + 1 else ch + qtd)

DispensadorQuente = Dispensador(BebidasQuentes) [[ servir <- servir_quente ]]
DispensadorFrio = Dispensador(BebidasFrias) [[ servir <- servir_frio ]]
InterfacePagamento = Pagamento [[ autorizar <- liberado ]]

Dispensadores = DispensadorQuente  ||| DispensadorFrio

Consumo(c, l, ch) =
    (c >= 3 & escolher?id!cafe -> servir_quente!id!cafe -> Aviso(c-3, l, ch))
    []
    (c >= 1 and l >= 2 & escolher?id!cafe_c_leite -> servir_quente!id!cafe_c_leite -> Aviso(c-1, l-2, ch))
    []
    (ch >= 3 & escolher?id!chocolate -> servir_frio!id!chocolate -> Aviso(c, l, ch-3))
    []
    (c >= 1 and l >= 1 and ch >= 1 & escolher?id!cappuccino -> servir_quente!id!cappuccino -> Aviso(c-1, l-1, ch-1))

GerenciadorEstoque(c, l, ch) =
    Consumo(c, l, ch)
    []
    Reposicao(c, l, ch)
    

SISTEMA_ATENDIMENTO = InterfacePagamento [| {| liberado |} |] Dispensadores
MAQUINA_BASE = SISTEMA_ATENDIMENTO [| {| escolher, servir_quente, servir_frio |} |] GerenciadorEstoque(MAX_INSUMO, MAX_INSUMO, MAX_INSUMO)

-- Máquina com ocultação
MAQUINA = MAQUINA_BASE \ {| descontar, preparar, liberado|}

Usuario(id) =
    ins_creditos.id!pCafe -> escolher.id!cafe -> servir_quente.id!cafe -> Usuario(id)
    []
    ins_creditos.id!pCafeLeite -> escolher.id!cafe_c_leite -> servir_quente.id!cafe_c_leite -> Usuario(id)
    []
    ins_creditos.id!pChoco -> escolher.id!chocolate -> servir_frio.id!chocolate -> Usuario(id)
    []
    ins_creditos.id!pCappuc -> escolher.id!cappuccino -> servir_quente.id!cappuccino -> Usuario(id)


USUARIOS = ||| i : ID @ Usuario(i)

SISTEMA = MAQUINA [| {| ins_creditos, escolher, servir_quente, servir_frio |} |] USUARIOS

-- Verificações
SO_REPOSICAO = 
    repor?i?q -> SO_REPOSICAO
    []
    aviso_falta?i -> SO_REPOSICAO
    []
    ins_creditos?id?val -> SO_REPOSICAO

assert SISTEMA :[deterministic]
assert SISTEMA :[deadlock free]
assert SISTEMA :[divergence free]

assert SO_REPOSICAO [T= SISTEMA \ {| escolher, servir_quente, servir_frio, servir |}

---------------------- Parte 2 ------------------------

channel falha_pagamento, falha_preparo

-- Fases
FaseSelecao(id, bebida) = escolher.id!bebida -> SKIP
FasePagamento(id, val) = ins_creditos.id!val -> descontar.id!val -> SKIP
FasePreparo(bebida) = preparar!bebida -> SKIP
FaseEntrega(id, bebida) = servir.id!bebida -> SKIP

-- Def. Transação
Transacao(id, bebida, val) = 
    FaseSelecao(id, bebida) ;
    FasePagamento(id, val) ;
    FasePreparo(bebida) ;
    FaseEntrega(id, bebida); Transacao(id, bebida, val)


assert Transacao(1, cafe, pCafe) :[deterministic]
assert Transacao(1, cafe, pCafe) :[deadlock free]
assert Transacao(1, cafe, pCafe) :[divergence free]

MaquinaCFalhas = 
    escolher?id?bebida -> ins_creditos.id?val:{pCafe, pCafeLeite, pChoco, pCappuc} -> 
    (
        (FasePagamento(id, val) ; FasePreparo(bebida) ; FaseEntrega(id, bebida) ; MaquinaCFalhas) -- sucesso
        |~| 
        (falha_pagamento -> MaquinaCFalhas)  -- Falha no pagamento
        |~| 
        (FasePagamento(id, val) ; falha_preparo -> MaquinaCFalhas) --Falha no preparo
    )

assert Dispensador(BebidasQuentes) [[ servir <- servir_quente ]] [T= DispensadorQuente
assert Dispensador(BebidasFrias) [[ servir <- servir_frio ]] [T= DispensadorFrio

assert Pagamento [[ autorizar <- liberado ]] [F= InterfacePagamento

assert MaquinaCFalhas :[deterministic]
assert MaquinaCFalhas :[deadlock free]
assert MaquinaCFalhas :[divergence free]

-- Os processos alcançam o SKIP após realizar todas os seus eventos de comunicação

-- Caso um processo alcance o deadlock, ele nuncha chegará ao SKIP, então a máquina prenderá o fluxo de execução e impedirá que o resto das atividades sejam executadas. Isso acontece devido ao fato de que com o operador de composição sequencial, o próximo processo só é executado após o fim do processo à esquerda do operador.

-- Sim, é possível que sejam paralelas. Contudo, neste caso somente será executado o processo da sequência quando todos os processos da esquerda alcançarem o SKIP. Pensando no contexto de uma cafeteria. Um exemplo: Caso a máquina de café servisse outras coisas, ela poderia entregar este outro produto ao mesmo tempo em que o café está sendo preparado. Por exemplo, liberar um saquinho de açucar enquanto prepara o cafe