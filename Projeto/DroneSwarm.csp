-- ==========================================
-- Tipos e Constantes
-- ==========================================
MAX_BAT = 20
WARN_BAT = 6
RTH_BAT = 4
MAX_PRT_PTS = 5
ID = {0..5} 
RSSI = {0..10} 
MISSION_STEPS = {0..30}

datatype STATUS = OK | LOST_COMMS | LOW_QUALITY_COMMS | LOST_GPS | IMU_FAIL | INTERNAL_ERROR | CRITICAL_BATT
datatype MISSION_STATUS = MISSION_FINISHED | MISSION_FAILED
datatype OBSTACLE = NONE | PASSABLE | IMPASSABLE 

-- ==========================================
-- Canais de Comunicação Globais e Internos
-- ==========================================
-- Físicos e Ação
channel test, takeoff, land, return_home, move
channel recharge : {1 .. MAX_BAT}
channel consume_bat, batt_critical_rth, alert_low_batt

-- Sensores
channel check_status, report_error : STATUS
channel check_obstacle : OBSTACLE 
channel physical_problem

-- Telemetria e GCS
channel receive_mission : MISSION_STEPS
channel connect_to_gcs, ping_gcs : RSSI
channel report_gcs: MISSION_STATUS
channel alert_impassable 
channel take_control, manual_cmd, abort_manual

-- ==========================================
-- 1. SISTEMA ELÉTRICO (ELEC)
-- ==========================================
-- Gerencia estado de energia e garante que alertas sejam disparados apenas 1 vez ao cruzar limites.
ELEC(batt) =
    if batt == 0 then STOP
    else if batt == WARN_BAT then 
        alert_low_batt -> ELEC_NORMAL(batt)
    else if batt == RTH_BAT then 
        batt_critical_rth -> ELEC_LOW(batt)
    else ELEC_NORMAL(batt)

ELEC_NORMAL(batt) =
    consume_bat -> ELEC(batt-1)
    []
    batt < MAX_BAT & recharge?val:{1 .. (MAX_BAT - batt)} -> ELEC(batt+val)

ELEC_LOW(batt) =
    if batt == 0 then STOP
    else
        consume_bat -> ELEC_LOW(batt-1)
        []
        -- Se recarregar, volta para o processo principal para reavaliar a tensão
        batt < MAX_BAT & recharge?val:{1 .. (MAX_BAT - batt)} -> ELEC(batt+val) 

-- ==========================================
-- 2. SISTEMA DE SENSORES (SENS)
-- ==========================================
-- Representa o Hardware lendo o mundo físico continuamente.
SENS = 
    check_status?s -> SENS
    []
    check_obstacle?obs -> SENS
    []
    physical_problem -> SENS

-- ==========================================
-- 3. SISTEMA DE COMUNICAÇÃO (COMM)
-- ==========================================
-- Roteador de telemetria. (Poderia ter estados de ONLINE/OFFLINE aqui no futuro)
COMM = 
    connect_to_gcs?rssi -> COMM
    [] ping_gcs?rssi -> COMM
    [] receive_mission?m_steps -> COMM
    [] take_control -> COMM
    [] manual_cmd -> COMM
    [] alert_impassable -> COMM
    [] report_gcs?st -> COMM
    [] report_error?err -> COMM
    [] alert_low_batt -> COMM
    [] abort_manual -> COMM

-- ==========================================
-- 4. SISTEMA DE CONTROLE / AUTOPILOTO (CONTROL)
-- ==========================================
CONTROL =
    check_status?s -> 
        if s == OK then connect_to_gcs?rssi -> CTRL_WAIT
        else report_error!s -> CONTROL

CTRL_WAIT =
    test -> consume_bat -> CTRL_WAIT
    []
    receive_mission?m_steps -> takeoff -> consume_bat -> CTRL_FLY(m_steps)
    []
    batt_critical_rth -> CTRL_WAIT
    []
    take_control -> DO_MANUAL -- Permite assumir o controle mesmo com o drone no chão

CTRL_FLY(m) = 
    -- 1. Checagem de Interrupções no topo do ciclo (Avionics Loop)
    take_control -> DO_MANUAL
    []
    batt_critical_rth -> DO_RTH
    []
    -- 2. Lógica normal de voo caso não haja interrupções
    (
        if m == 0 then 
            report_gcs!MISSION_FINISHED -> return_home -> consume_bat -> land -> CTRL_WAIT
        else 
            check_status?s -> 
                if s == OK then 
                    check_obstacle?obs -> 
                        if obs == IMPASSABLE then 
                            alert_impassable -> CTRL_FLY(m-1) 
                        else 
                            move -> consume_bat -> CTRL_FLY(m-1)
                else report_error!s -> return_home -> consume_bat -> land -> CTRL_WAIT
    )

DO_MANUAL =
    manual_cmd -> consume_bat -> DO_MANUAL
    []
    physical_problem -> abort_manual -> land -> CTRL_WAIT
    []
    batt_critical_rth -> DO_RTH

DO_RTH =
    return_home -> consume_bat -> land -> CTRL_WAIT
    
-- ==========================================
-- COMPOSIÇÃO PARALELA DO DRONE
-- ==========================================
-- Definimos quais fios (canais) conectam as placas (processos) dentro do Drone.

-- Fios conectando Controle e Comunicação
SYNC_CTRL_COMM = {| connect_to_gcs, receive_mission, alert_impassable, report_gcs, report_error, take_control, manual_cmd, abort_manual |}
-- Fios conectando Controle e Sensores
SYNC_CTRL_SENS = {| check_status, check_obstacle, physical_problem |}
-- Fios conectando Controle e Elétrica
SYNC_CTRL_ELEC = {| consume_bat, batt_critical_rth |}
-- Fios conectando Comunicação e Elétrica
SYNC_COMM_ELEC = {| alert_low_batt |}

-- O DRONE COMPLETO (Montando os blocos)
SYS_1 = CONTROL [| SYNC_CTRL_COMM |] COMM
SYS_2 = SYS_1 [| SYNC_CTRL_SENS |] SENS
DRONE_PARALLEL = SYS_2 [| union(SYNC_CTRL_ELEC, SYNC_COMM_ELEC) |] ELEC(10)


-- ==========================================
-- SISTEMA EXTERNO: A GROUND CONTROL STATION
-- ==========================================
GCS = 
    connect_to_gcs?rssi -> GCS
    [] ping_gcs?rssi -> GCS
    [] receive_mission?steps -> GCS
    [] alert_low_batt -> GCS
    [] report_error?err -> GCS
    [] report_gcs?status -> GCS
    [] alert_impassable -> GCS
    [] take_control -> GCS
    [] manual_cmd -> GCS
    [] abort_manual -> GCS

SYNC_DRONE_GCS = {| connect_to_gcs, receive_mission, ping_gcs, alert_low_batt, report_error, report_gcs, alert_impassable, take_control, manual_cmd, abort_manual |}

Sistema = DRONE_PARALLEL [| SYNC_DRONE_GCS |] GCS

-- ==========================================
-- Asserções e Refinamentos (Testes do FDR4)
-- ==========================================
assert Sistema :[deterministic]
assert Sistema :[deadlock free]
assert Sistema :[divergence free]