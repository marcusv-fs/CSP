-- ==========================================
-- Tipos e Constantes
-- ==========================================
MAX_BAT = 10
WARN_BAT = 3
RTH_BAT = 2

ID = {0..1}
RSSI = {0..10}
MISSION_STEPS = {0..10}

datatype STATUS = OK | LOST_COMMS | LOW_QUALITY_COMMS | LOST_GPS | IMU_FAIL | INTERNAL_ERROR
datatype MISSION_STATUS = MISSION_FINISHED | MISSION_FAILED
datatype OBSTACLE = NONE | PASSABLE | IMPASSABLE

-- ==========================================
-- Canais de Comunicação Globais e Internos
-- ==========================================

-- Eventos físicos
channel test, takeoff, land, return_home, move
channel recharge : {1..MAX_BAT}
channel consume_bat, batt_critical_rth

-- Sensores (internos ao drone)
channel check_status : STATUS
channel check_obstacle : OBSTACLE
channel physical_problem

-- Comunicação Drone <-> GCS
channel connect_to_gcs : ID.RSSI
channel ping_gcs : ID.RSSI
channel receive_mission : ID.MISSION_STEPS
channel report_gcs : ID.MISSION_STATUS
channel report_error : ID.STATUS
channel alert_low_batt, alert_impassable, take_control, manual_cmd, abort_manual : ID

-- ==========================================
-- 1. SISTEMA ELÉTRICO (ELEC)
-- ==========================================
ELEC(id, batt) =
    if batt == 0 then STOP
    else if batt == WARN_BAT then
        alert_low_batt.id -> ELEC_NORMAL(id, batt)
    else if batt == RTH_BAT then
        batt_critical_rth -> ELEC_LOW(id, batt)
    else ELEC_NORMAL(id, batt)

ELEC_NORMAL(id, batt) =
    consume_bat -> ELEC(id, batt-1)
    [] batt < MAX_BAT & recharge?val:{1..(MAX_BAT-batt)} -> ELEC(id, batt+val)

ELEC_LOW(id, batt) =
    if batt == 0 then STOP
    else
        consume_bat -> ELEC_LOW(id, batt-1)
        [] batt < MAX_BAT & recharge?val:{1..(MAX_BAT-batt)} -> ELEC(id, batt+val)

-- ==========================================
-- 2. SISTEMA DE SENSORES (SENS)
-- ==========================================
SENS =
    check_status?status -> SENS
    [] check_obstacle?obs -> SENS
    [] physical_problem -> SENS

-- ==========================================
-- 3. SISTEMA DE COMUNICAÇÃO (COMM)
-- ==========================================
COMM(id) = COMM_DISCONNECTED(id)

COMM_DISCONNECTED(id) =
    connect_to_gcs.id?rssi -> COMM_CONNECTED(id)

COMM_CONNECTED(id) =
    ping_gcs.id?rssi -> COMM_CONNECTED(id)
    [] receive_mission.id?m_steps -> COMM_CONNECTED(id)
    [] take_control.id -> COMM_CONNECTED(id)
    [] manual_cmd.id -> COMM_CONNECTED(id)
    [] alert_impassable.id -> COMM_CONNECTED(id)
    [] report_gcs.id?st -> COMM_CONNECTED(id)
    [] report_error.id?err -> COMM_CONNECTED(id)
    [] alert_low_batt.id -> COMM_CONNECTED(id)
    [] abort_manual.id -> COMM_CONNECTED(id)

-- ==========================================
-- 4. SISTEMA DE CONTROLE / AUTOPILOTO (CONTROL)
-- ==========================================
CONTROL(id) =
    connect_to_gcs.id?rssi -> CTRL_INIT(id)

CTRL_INIT(id) =
    check_status?status ->
        if status == OK then CTRL_WAIT(id)
        else report_error.id!status -> CTRL_INIT(id)

CTRL_WAIT(id) =
    test -> consume_bat -> CTRL_WAIT(id)
    [] receive_mission.id?m_steps -> takeoff -> consume_bat -> CTRL_FLY(id, m_steps)
    [] batt_critical_rth -> CTRL_WAIT(id)
    [] take_control.id -> DO_MANUAL(id)

CTRL_FLY(id, m_steps) =
    take_control.id -> DO_MANUAL(id)
    [] batt_critical_rth -> DO_RTH(id)
    []
    (
        if m_steps == 0 then
            report_gcs.id!MISSION_FINISHED -> return_home -> consume_bat -> land ->CTRL_WAIT(id)
        else
            check_status?status -> 
                if status == OK then check_obstacle?obs ->
                    if obs == IMPASSABLE then alert_impassable.id -> CTRL_FLY(id, m_steps - 1)
                    else move -> consume_bat -> CTRL_FLY(id, m_steps - 1)
                else report_error.id!status -> return_home -> consume_bat -> land -> CTRL_WAIT(id)
    )

DO_MANUAL(id) =
    manual_cmd.id -> consume_bat -> DO_MANUAL(id)
    [] physical_problem -> abort_manual.id -> land -> CTRL_WAIT(id)
    [] batt_critical_rth -> DO_RTH(id)

DO_RTH(id) =
    return_home -> consume_bat -> land -> CTRL_WAIT(id)

-- ==========================================
-- COMPOSIÇÃO PARALELA DO DRONE
-- ==========================================
SYNC_CTRL_COMM = {| connect_to_gcs, receive_mission, report_error, report_gcs,
                    alert_impassable, take_control, manual_cmd, abort_manual |}
SYNC_CTRL_SENS = {| check_status, check_obstacle, physical_problem |}
SYNC_CTRL_ELEC = {| consume_bat, batt_critical_rth |}
SYNC_COMM_ELEC = {| alert_low_batt |}

SYS_1(id) =
    CONTROL(id) [| SYNC_CTRL_COMM |] COMM(id)

SYS_2(id) =
    SYS_1(id) [| SYNC_CTRL_SENS |] SENS

DRONE(id) =
    SYS_2(id) [| union(SYNC_CTRL_ELEC,SYNC_COMM_ELEC) |] ELEC(id,10)

DRONES = ||| id:ID @ DRONE(id)

-- ==========================================
-- GCS - CONNECTION
-- ==========================================
GCS_CONNECTION =
    [] id:ID @ connect_to_gcs.id?rssi -> GCS_CONNECTION
    []
    [] id:ID @ ping_gcs.id?rssi -> GCS_CONNECTION

-- ==========================================
-- GCS - OPERATOR
-- ==========================================
GCS_OPERATOR =
    [] id:ID @ take_control.id -> GCS_MANUAL(id)

GCS_MANUAL(id) =
    manual_cmd.id -> GCS_MANUAL(id)
    [] abort_manual.id -> GCS_OPERATOR

-- ==========================================
-- GCS - TELEMETRY
-- ==========================================
GCS_TELEMETRY =
    [] id:ID @ receive_mission.id?steps -> GCS_TELEMETRY
    []
    [] id:ID @ report_gcs.id?status -> GCS_TELEMETRY
    []
    [] id:ID @ alert_impassable.id -> GCS_TELEMETRY

-- ==========================================
-- GCS - ALARMS
-- ==========================================
GCS_ALARM =
    [] id:ID @ alert_low_batt.id -> GCS_ALARM
    []
    [] id:ID @ report_error.id?err -> GCS_ALARM

-- ==========================================
-- GCS
-- ==========================================
GCS_1 =
    GCS_CONNECTION [|{}|] GCS_OPERATOR

GCS_2 =
    GCS_1 [|{}|] GCS_TELEMETRY

GCS =
    GCS_2 [|{}|] GCS_ALARM

SYNC_DRONE_GCS = {| connect_to_gcs, ping_gcs, receive_mission, report_gcs,
                 report_error, alert_low_batt, alert_impassable, take_control,
                 manual_cmd, abort_manual|}

Sistema = DRONES [| SYNC_DRONE_GCS |] GCS

-- ==========================================
-- Asserções e Refinamentos (Testes do FDR4)
-- ==========================================
assert Sistema :[deterministic]
assert Sistema :[deadlock free]
assert Sistema :[divergence free]