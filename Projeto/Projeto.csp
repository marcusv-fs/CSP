-- 1. Definições de Tipos e Constantes
DRONES = {1..2}
POS = {1..2}
ROT = {1..2}

datatype CHECK = FALHA | SUCESSO
datatype MISSION = SEEK | FIGHT | TEST | GUARD | ABORT
datatype ERROR_TYPE = NO_ERROR | COLISION_DETECTED | UNABLE_TO_MOVE | LOST_COMMS | GPS_ERROR | INS_ERROR | INVALID_STATUS

-- 2. Declaração de Canais
channel disarmed, arm, setHome, waiting_mission, land, exec_mission, back_to_home: DRONES
channel receiveMission, interrupt_mission: DRONES.MISSION
channel takeoff: DRONES.POS.ROT
channel reach_status: DRONES.CHECK 
channel analize_error: DRONES.ERROR_TYPE
channel take_photo, follow_target, target_lost, alert_gcs, tg_lost_alert, std_move, guard_move, collide, found_something: DRONES

-- 3. Função de Check Pré-Voo
Pre_flight_checks(gps, ins, comms, status) = 
    if (gps == FALHA) then GPS_ERROR
    else if (ins == FALHA) then INS_ERROR
    else if (comms == FALHA) then LOST_COMMS
    else if (status == FALHA) then INVALID_STATUS
    else NO_ERROR

-- 4. Processos do Drone
Drone(id, gps, ins, comms, status) = 
    disarmed.id ->
    if (Pre_flight_checks(gps, ins, comms, status) == NO_ERROR) then 
        setHome.id -> DroneWaiting(id)
    else 
        DroneError(id, Pre_flight_checks(gps, ins, comms, status))

DroneWaiting(id) = 
    waiting_mission.id -> receiveMission.id?mission -> arm.id -> takeoff.id?z?yaw -> 
    reach_status.id?resultado -> 
    if (resultado == SUCESSO) then 
        DroneOperationalLoop(id, mission)
    else 
        DroneError(id, UNABLE_TO_MOVE)

-- interrupt_mission pode parar droneOper a qualquer instante
DroneOperationalLoop(id, mission) = 
    DroneOper(id, mission) /\ interrupt_mission.id?new_mission -> DroneOperationalLoop(id, new_mission)

DroneOper(id, mission) = 
    exec_mission.id ->
    if (mission == SEEK) then DroneSeek(id)
    else if (mission == TEST) then DroneTest(id)
    else if (mission == GUARD) then DroneGuard(id)
    else if (mission == ABORT) then DroneAbort(id)
    else DroneFight(id)

-- 5. Comportamentos Específicos das Missões

-- SEEK: Segue e fotografa. Se perder, avisa a GCS e aceita reconfiguração local
DroneSeek(id) = 
    take_photo.id -> follow_target.id -> 
    (
        DroneSeek(id) 
        |~| 
        target_lost.id -> tg_lost_alert.id -> receiveMission.id?nova_m -> DroneOper(id, nova_m)
    )

-- TEST: Movimentos padrão, volta pra casa e finaliza graciosamente com SKIP
DroneTest(id) = 
    std_move.id -> DroneAbort(id)

-- GUARD: Movimentos cíclicos. Se achar algo, alerta a GCS, mas continua patrulhando
DroneGuard(id) = 
    guard_move.id -> take_photo.id -> 
    (
        found_something.id -> alert_gcs.id -> DroneGuard(id)
        |~|
        DroneGuard(id)
    )

-- FIGHT: Segue o alvo de forma agressiva até colidir (o que gera um erro controlado)
DroneFight(id) = 
    follow_target.id -> collide.id -> DroneError(id, COLISION_DETECTED)

DroneAbort(id) = 
    back_to_home.id -> land.id -> disarmed.id -> SKIP

-- Gerenciador de Erros
DroneError(id, erro) = 
    analize_error.id!erro ->
    if (erro == COLISION_DETECTED or erro == UNABLE_TO_MOVE) then 
        alert_gcs.id -> STOP 
    else if (erro == LOST_COMMS) then 
        back_to_home.id -> land.id -> STOP
    else 
        alert_gcs.id -> STOP 

---

-- 6. Estação de Controle de Solo (GCS)
GCS(id) = 
    waiting_mission.id -> receiveMission.id!GUARD -> GCS_Ativa(id)

GCS_Ativa(id) = 
    -- Se o drone alertar algo na patrulha, ordena o ataque (Interrupção)
    alert_gcs.id -> interrupt_mission.id!FIGHT -> GCS_Ativa(id)
    []
    tg_lost_alert.id > interrupt_mission.id!ABORT -> GCS(id)
    -- A GCS também pode decidir aleatoriamente testar o drone a qualquer momento
    []
    interrupt_mission.id!TEST -> GCS(id)
    []
    -- Permite reconfiguração normal caso solicitada no modo SEEK
    receiveMission.id!SEEK -> GCS_Ativa(id)

-- 7. Sistema Completo (Composição Paralela)
-- Sincroniza o Drone e a GCS nos canais de comunicação compartilhados
AlphaDrone = {| waiting_mission, receiveMission, interrupt_mission, alert_gcs |}

-- Enxame intercalado (5 drones operando paralelamente sem se bloquearem)
Swarm = ||| id:DRONES @ Drone(id, SUCESSO, SUCESSO, SUCESSO, SUCESSO)

-- GCS intercalada (GCS gerenciando os 5 drones independentemente)
GroundControl = ||| id:DRONES @ GCS(id)

Sistema = Swarm [ AlphaDrone || AlphaDrone ] GroundControl

assert Sistema :[deterministic]
assert Sistema :[deadlock free]
assert Sistema :[divergence free]